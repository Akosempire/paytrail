# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The public address of this app, no trailing slash. Used in payment
# redirect links, webhook URLs shown in the setup guide, and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random characters. Encrypts each business's payment keys at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it after businesses have connected payments, or their keys can't be read.
APP_ENCRYPTION_KEY=

# ---- Email (optional). Without it, Usetally gives you links to copy/share instead. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Usetally <hello@usetally.cc>"

# Secret for the scheduled jobs (payment re-checks, and the 6-hourly ad report).
# Vercel Cron sends it, so it must live here, not in the dashboard.
CRON_SECRET=

# ---- Meta ads (optional fallbacks) ----
# Set these in Admin → Marketing → Meta connection instead (stored encrypted,
# no redeploy). Values here are only used when the dashboard fields are empty.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=2167224513581774
META_PIXEL_ID=
META_CAPI_TOKEN=

# Optional: Cloudflare Turnstile on sign-up and password reset (both needed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Leave unset in production. "1" lets customers pay with test-mode keys (staging only).
PAYTRAIL_ALLOW_TEST_PAYMENTS=

# ---- Legal pages (/terms and /privacy) ----
# Your registered business name, address and the email for legal/privacy requests.
LEGAL_COMPANY_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Where your Supabase project stores data (shown on /subprocessors), e.g. "European Union (Frankfurt)".
LEGAL_DATA_REGION=
# The email service you use for SMTP, e.g. "Resend" or "Zoho Mail" (shown on /subprocessors).
LEGAL_EMAIL_PROVIDER=

# ---- Brevo (email: security codes, documents, alerts) ----
# In Brevo: Settings → SMTP & API → SMTP. Use the "Login" shown there (looks
# like 9a1b2c001@smtp-brevo.com) and an SMTP key (starts with xsmtpsib-).
# MAIL_FROM must be a sender you've verified in Brevo (Senders & IP).
# Sign-up codes, password resets and every other email are sent by the app
# through these settings (not by Supabase). Adding the same SMTP in Supabase
# (Authentication → Emails → SMTP) is optional: it only covers the fallback.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your Brevo SMTP login>
#   SMTP_PASS=<your Brevo SMTP key>
#   MAIL_FROM="Usetally <hello@usetally.cc>"

# Who gets admin alerts (new businesses, payment key changes). Comma separated.
# Leave empty to alert every platform admin.
ADMIN_ALERT_EMAILS=
